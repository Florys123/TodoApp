<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TodoApp.Models"
             x:Class="TodoApp.MainPage"
             x:Name="Page"
             Title="TodoApp">

    <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">

        <!-- Верхняя панель: поле ввода + кнопка "+" -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry Grid.Column="0"
                   Placeholder="Новая задача..."
                   Text="{Binding NewTaskTitle}" />
            <Button Grid.Column="1"
                    Text="+"
                    Command="{Binding AddTaskCommand}" />
        </Grid>

        <!-- Список задач -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Tasks}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TodoItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,4">

                        <!-- Галочка -->
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsDone}" />

                        <!-- Текст задачи  -->
                        <Label Grid.Column="1"
                               Text="{Binding Title}"
                               VerticalOptions="Center">
                            <!-- Клик по тексту → команда StartEditCommand во ViewModel -->
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.StartEditCommand}"
                                    CommandParameter="{Binding .}" />
                            </Label.GestureRecognizers>
                            <!-- Показываем Label, только когда НЕ редактируем -->
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsEditing}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <!-- Поле редактирования  -->
                        <Entry Grid.Column="1"
                               Text="{Binding Title}"
                               IsVisible="{Binding IsEditing}"
                               ReturnCommand="{Binding Source={x:Reference Page}, Path=BindingContext.FinishEditCommand}"
                               ReturnCommandParameter="{Binding .}" />

                        <!-- Кнопка удаления -->
                        <Button Grid.Column="2"
                                Text="🗑"
                                Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteTaskCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>